	"nodes":[
		{"id":"974fef113916abc8","type":"text","text":"# Flux\n\n\n\n$$ \n\\Phi \n$$","x":-280,"y":-100,"width":190,"height":120},
		{"id":"5b3729a64387c38a","type":"text","text":"$$\nQ = \\int_{t_0}^{t_1} \\Phi(t)\\text{d}t\n$$","x":-20,"y":-314,"width":302,"height":102,"color":"6"},
		{"id":"18f1a5c38e68a866","type":"text","text":"\n\n$$\nE(\\text{p}) = \\lim_{\\Delta A\\rightarrow 0}\\frac{\\Delta \\Phi(\\text{p})}{\\Delta A} = \\frac{\\text{d}\\Phi(\\text{p})}{\\text{d}A}\n$$\n\n","x":-889,"y":240,"width":289,"height":119,"color":"1"},
		{"id":"92da99033ddad8b1","type":"text","text":"\n\n$$  \n\\Phi = \\int_{A} E(\\text{p})\\text{d}A  \n$$\n\n  \n\n","x":-541,"y":240,"width":206,"height":119,"color":"6"},
		{"id":"85b57cf4de366599","type":"text","text":"朗伯定律（Lambert’s law）","x":-1200,"y":240,"width":250,"height":60},
		{"id":"47d325a183baaed4","type":"text","text":"# Irradiance\n\n\n\n$$ \nE\n$$","x":-844,"y":520,"width":200,"height":120},
		{"id":"2110c1d049e29bd6","type":"text","text":"$$\n\\Phi = \\lim_{\\Delta t \\rightarrow 0}\\frac{\\Delta Q}{\\Delta t} = \\frac{\\text{d}Q}{\\text{d}t}\n$$","x":-315,"y":-314,"width":265,"height":88,"color":"1"},
		{"id":"fa97ce8b1ce38ff3","type":"text","text":"# Emergy\n\n$$ \nQ = \\frac{hc}{λ}\n$$","x":-292,"y":-560,"width":220,"height":120},
		{"id":"d66cbe45dc067aa8","type":"text","text":"$$\nI = \\lim_{\\Delta\\omega\\rightarrow 0}\\frac{\\Delta\\Phi}{\\Delta\\omega} = \\frac{\\text{d}\\Phi}{\\text{d}\\omega}\n$$","x":200,"y":254,"width":263,"height":105,"color":"1"},
		{"id":"3ae8708318952fbd","type":"text","text":"# Intensity\n\n$$ I$$","x":213,"y":526,"width":250,"height":120},
		{"id":"4791598ef1207b1b","type":"text","text":"$$\n\\Phi = \\int_{\\Omega} I(\\omega)\\text{d}\\omega\n$$","x":-120,"y":240,"width":253,"height":83,"color":"6"},
		{"id":"911e9dbd5410e51b","type":"text","text":"$$\nL(\\text{p},\\omega) = \\lim_{\\Delta\\omega\\rightarrow 0}\\frac{\\Delta E_{\\omega}(\\text{p})}{\\Delta\\omega} = \\frac{\\text{d}E_{\\omega}(\\text{p})}{\\text{d}\\omega}\n$$","x":-909,"y":760,"width":330,"height":98,"color":"1"},
		{"id":"6416247984b013c5","type":"text","text":"$$ \n\nL = \\frac{\\text{d}^2\\Phi}{\\text{d}\\omega\\text{d}A^{\\perp}}\n\n$$","x":-310,"y":473,"width":250,"height":113,"color":"1"},
		{"id":"c2cd0e2721169f5d","type":"text","text":"# Radiance\n\n$$ L$$","x":-310,"y":1000,"width":250,"height":95},
		{"id":"a4eb21c6f43e004d","type":"text","text":"$$ \n\nL = \\frac{\\text{d}I}{\\text{d}A^{\\perp}}\n\n$$","x":213,"y":800,"width":250,"height":113,"color":"1"},
